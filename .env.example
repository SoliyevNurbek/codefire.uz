# Django REST API base URL (no trailing slash). Endpoints live under /api/...
NEXT_PUBLIC_API_URL=http://localhost:8000
# Django Channels WebSocket base URL. Paths: ws/submissions/{id}/, ws/contests/{id}/standings/
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# "enabled" (default) answers every request from mocks/ with realistic data.
# Set to "disabled" to talk to the real Django backend above.
NEXT_PUBLIC_API_MOCKING=enabled
